{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RAGE File Scanner",
  "version": "1.0.9",
  "identifier": "com.altaf.rage-file-checker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RAGE File Scanner",
        "width": 1180,
        "height": 800,
        "minWidth": 960,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Aftlah",
    "copyright": "Copyright © Aftlah",
    "shortDescription": "Read-only scanner for FiveM files",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUxOEQ5NjA1RUYyQjQxRTkKUldUcFFTdnZCWmFOVWZianBvRjJkNlYvTVloR2hOOUZVRE9wd3prbC9ILzE0aUNkVE55dkZrbTQK",
      "endpoints": [
        "https://github.com/aftlah/rage-fivem-fileChecker/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
