# Discord webhook for scan reports (DO NOT COMMIT)
# One file per company: .discord.rage.env, .discord.bbc.env (each tenant uses ONLY its own file)
# 1. Discord channel → Edit Channel → Integrations → Webhooks → New Webhook → Copy URL
# 2. Paste below, then run: npm run release -- --tenant=rage
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE_ME
